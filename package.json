{
    "name": "vex-chat",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm -r --parallel dev",
        "prepare": "husky",
        "registry": "npx verdaccio -c .verdaccio/config.yaml",
        "publish:local": "./scripts/publish-local.sh",
        "install:local": "./scripts/install-local.sh",
        "link:local-protocol": "bash ./scripts/link-local-protocol.sh",
        "build": "pnpm -r --if-present build",
        "test": "pnpm -r --if-present test",
        "typecheck": "pnpm -r --if-present typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "pnpm -r --if-present lint",
        "lint:fix": "pnpm -r --if-present lint:fix",
        "lint:pkg": "pnpm dlx npm-package-json-lint .",
        "license:check": "pnpm -r --if-present license:check",
        "icons:regen": "bash ./scripts/generate-app-icons.sh",
        "mobile": "pnpm -F mobile dev",
        "android:dev": "pnpm -F mobile run android:dev",
        "android:dev:local": "pnpm -F mobile run android:dev:local",
        "android:dev:install": "pnpm -F mobile run android:dev:install",
        "android:prod": "pnpm -F mobile run android:prod",
        "android:prod:install": "pnpm -F mobile run android:prod:install",
        "android:reset-db": "pnpm -F mobile run android:reset-db",
        "android:staging": "pnpm run android:dev",
        "install:android": "pnpm -F mobile run android:release:install-all",
        "ios:dev:install": "pnpm -F mobile run ios:dev:install",
        "ios:dev:local": "pnpm -F mobile run ios:dev:local",
        "ios:prod:install": "pnpm -F mobile run ios:prod:install",
        "install:ios": "pnpm -F mobile run ios:prod:install",
        "desktop": "pnpm -F @vex-chat/desktop dev",
        "desktop:dev": "pnpm -F @vex-chat/desktop run install:development",
        "desktop:dev:build": "pnpm -F @vex-chat/desktop run build:development",
        "desktop:dev:install": "pnpm -F @vex-chat/desktop run install:development",
        "desktop:prod": "pnpm -F @vex-chat/desktop run install:production",
        "desktop:prod:build": "pnpm -F @vex-chat/desktop run build:production",
        "desktop:prod:install": "pnpm -F @vex-chat/desktop run install:production",
        "desktop:vite": "pnpm -F @vex-chat/desktop run vite:dev",
        "desktop:vite:local": "pnpm -F @vex-chat/desktop run vite:local",
        "website": "pnpm -F @vex-chat/website dev:all",
        "preinstall": "npx only-allow pnpm"
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=10.0.0"
    },
    "devDependencies": {
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "prettier": "^3.2.0",
        "prettier-plugin-svelte": "^3.5.1",
        "typescript": "catalog:",
        "typescript-eslint": "^8.32.1"
    },
    "pnpm": {
        "overrides": {
            "react": "19.2.0",
            "react-dom": "19.2.0",
            "kysely": "0.28.17",
            "typescript": "~5.9.3",
            "svelte@<4.2.19": ">=4.2.19",
            "esbuild@<=0.24.2": ">=0.25.0",
            "esbuild@>=0.27.3 <0.28.1": "0.28.1",
            "esbuild@0.27.7": "0.28.1",
            "svelte@<=5.51.4": ">=5.51.5",
            "svelte@<=5.53.4": ">=5.53.5",
            "svelte@<=5.55.6": ">=5.55.7",
            "devalue@>=5.6.3 <=5.8.0": ">=5.8.1",
            "vite@<=6.4.2": ">=6.4.3",
            "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
            "vite@>=7.1.0 <=7.3.4": ">=7.3.5",
            "follow-redirects@<=1.15.11": ">=1.16.0",
            "fast-xml-parser@<5.7.0": ">=5.7.0",
            "@xmldom/xmldom": "0.8.15",
            "fast-xml-builder@<=1.1.6": "1.1.7",
            "uuid@<11.1.1": "11.1.1",
            "brace-expansion@<1.1.18": "1.1.18",
            "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
            "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
            "ws@>=6.0.0 <6.2.4": "6.2.4",
            "ws@>=7.0.0 <7.5.11": "7.5.11",
            "ws@>=8.0.0 <8.21.0": "8.21.0",
            "shell-quote@<1.9.0": "1.9.0",
            "joi@<17.13.4": "17.13.4",
            "@babel/core@<=7.29.0": "7.29.6",
            "launch-editor@<=2.14.0": "2.14.1",
            "body-parser@<1.20.6": "1.20.6",
            "@angular/compiler@<=19.2.25": "20.3.27",
            "@angular/compiler@>=20.0.0 <20.3.27": "20.3.27",
            "postcss@<8.5.23": "8.5.23",
            "js-yaml@>=3 <3.15.1": "3.15.1",
            "js-yaml@>=4 <4.3.1": "4.3.1",
            "dompurify@<3.4.13": "3.4.13",
            "nanoid@<3.3.18": "3.3.18",
            "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.3",
            "postcss-selector-parser@>=7.1.0 <7.1.3": "7.1.3",
            "browserslist@<4.28.7": "4.28.7",
            "@humanfs/node@<0.16.8": "0.16.8",
            "qs@<6.16.0": "6.16.0"
        },
        "peerDependencyRules": {
            "allowedVersions": {
                "expo-sqlite": ">=16",
                "typescript": ">=5",
                "@sveltejs/vite-plugin-svelte": ">=2"
            }
        },
        "onlyBuiltDependencies": [
            "sharp",
            "better-sqlite3",
            "esbuild",
            "msgpackr-extract"
        ],
        "auditConfig": {
            "ignoreCves": [
                "CVE-2026-14257"
            ]
        }
    },
    "license": "AGPL-3.0-or-later"
}
