{
    "compilerOptions": {
        "jsx": "preserve",
        "jsxImportSource": "@builder.io/mitosis",
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "esnext",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "include": [
        "src",
        "scripts",
        ".storybook/main.ts",
        ".storybook-react/main.ts",
        ".storybook-svelte/main.ts"
    ]
}
