{
    "name": "@vex-chat/ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./react/*": "./output/react/src/*",
        "./svelte/*": "./output/svelte/src/*"
    },
    "scripts": {
        "build": "mitosis build && tsx scripts/gen-story-wrappers.ts",
        "build:react": "mitosis build --targets react",
        "build:svelte": "mitosis build --targets svelte",
        "gen-stories": "tsx scripts/gen-story-wrappers.ts",
        "storybook": "concurrently \"storybook dev -p 6001 -c .storybook-react\" \"storybook dev -p 6002 -c .storybook-svelte\" \"tsx scripts/wait-for-storybooks.ts http://localhost:6001 http://localhost:6002 && storybook dev -p 6000 -c .storybook\""
    },
    "devDependencies": {
        "@builder.io/mitosis": "^0.14.0",
        "@builder.io/mitosis-cli": "^0.14.0",
        "@storybook/addon-essentials": "^8.6.0",
        "@storybook/react-vite": "^8.6.0",
        "@storybook/svelte-vite": "^8.6.0",
        "@types/node": "catalog:",
        "@vex-chat/eslint-config": "workspace:*",
        "concurrently": "^10.0.5",
        "react": "catalog:",
        "react-dom": "catalog:",
        "storybook": "^8.6.0",
        "svelte": "catalog:",
        "tsx": "^4.23.12",
        "vite": "^8.2.1"
    },
    "license": "AGPL-3.0-or-later"
}
