{
    "name": "@vex-chat/mobile",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "android:clean-autolinking": "node -e \"require('node:fs').rmSync('android/build/generated/autolinking', { recursive: true, force: true })\"",
        "android": "VEX_MOBILE_TARGET=dev expo run:android",
        "android:dev": "pnpm run android",
        "android:dev:install": "bash ./scripts/android-dev-install.sh",
        "android:development": "pnpm run development:android",
        "android:prod": "bash ./scripts/android-prod.sh",
        "android:prod:install": "bash ./scripts/android-prod-install.sh",
        "android:staging": "pnpm run development:android:gradle-install",
        "android:multi": "bash ./scripts/run-with-android-jdk.sh bash ./scripts/android-with-logs.sh",
        "android:emulator": "bash ./scripts/run-with-android-jdk.sh bash ./scripts/start-android-emulator.sh",
        "android:release:install-all": "bash ./scripts/release-apk-install-all.sh",
        "android:reset-db": "bash ./scripts/android-reset-db.sh",
        "ios:release:install": "bash ./scripts/install-ios-release.sh",
        "ios": "VEX_MOBILE_TARGET=dev expo run:ios",
        "dev": "VEX_MOBILE_TARGET=dev expo run:android",
        "icons:regen": "bash ./scripts/generate-icons-from-vex-svg.sh",
        "dev:metro": "VEX_MOBILE_TARGET=dev expo start --dev-client",
        "dev:local": "EXPO_PUBLIC_ENABLE_DEV_SERVER=1 EXPO_PUBLIC_SERVER_URL=localhost:16777 pnpm run dev",
        "dev:lan": "EXPO_PUBLIC_ENABLE_DEV_SERVER=1 EXPO_PUBLIC_SERVER_URL=$(ipconfig getifaddr en0):16777 pnpm run dev",
        "dev:android-reverse": "adb reverse tcp:16777 tcp:16777 && EXPO_PUBLIC_ENABLE_DEV_SERVER=1 EXPO_PUBLIC_SERVER_URL=localhost:16777 pnpm run dev",
        "passkeys:doctor": "node ./scripts/passkeys-doctor.cjs",
        "development:android": "VEX_MOBILE_TARGET=development eas build --profile development --platform android --local --non-interactive --output ../../vex-development-local.apk",
        "development:android:gradle-install": "bash ./scripts/android-dev-install.sh",
        "development:prebuild": "VEX_MOBILE_TARGET=development EAS_BUILD_PROFILE=development expo prebuild --clean",
        "prebuild": "VEX_MOBILE_TARGET=dev expo prebuild --clean",
        "start": "pnpm run dev:metro",
        "legacy:android": "pnpm run android:clean-autolinking && bash ./scripts/run-with-android-jdk.sh bash ./scripts/android-run.sh",
        "logs:android:all": "bash ./scripts/logcat-all-devices.sh",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "license:check": "npx @onebeyond/license-checker scan --allowOnly MIT ISC BSD-2-Clause BSD-3-Clause Apache-2.0 0BSD MPL-2.0 CC0-1.0 CC-BY-4.0 Unlicense BlueOak-1.0.0 Python-2.0 Zlib PSF-2.0 Artistic-2.0 AGPL-3.0-or-later WTFPL --ignoreRootPackageLicense --disableReport"
    },
    "dependencies": {
        "@expo/vector-icons": "15.1.1",
        "@nanostores/react": "1.1.0",
        "@notifee/react-native": "9.1.8",
        "@react-navigation/bottom-tabs": "7.15.9",
        "@react-navigation/native": "7.2.2",
        "@react-navigation/native-stack": "7.14.10",
        "@vex-chat/store": "workspace:*",
        "expo": "55.0.26",
        "expo-audio": "55.0.14",
        "expo-background-fetch": "55.0.16",
        "expo-background-task": "55.0.18",
        "expo-blur": "55.0.14",
        "expo-constants": "55.0.16",
        "expo-crypto": "55.0.15",
        "expo-dev-client": "55.0.35",
        "expo-document-picker": "55.0.13",
        "expo-file-system": "55.0.22",
        "expo-haptics": "55.0.14",
        "expo-image-manipulator": "55.0.17",
        "expo-image-picker": "55.0.20",
        "expo-intent-launcher": "55.0.12",
        "expo-notifications": "55.0.23",
        "expo-secure-store": "55.0.14",
        "expo-sharing": "55.0.20",
        "expo-sqlite": "55.0.16",
        "expo-task-manager": "55.0.16",
        "expo-updates": "55.0.24",
        "expo-video": "55.0.17",
        "highlight.js": "catalog:",
        "kysely": "catalog:",
        "kysely-expo": "5.0.0",
        "nanostores": "catalog:",
        "react": "catalog:",
        "react-native": "0.83.6",
        "react-native-get-random-values": "1.11.0",
        "react-native-logs": "5.6.0",
        "react-native-passkey": "3.3.3",
        "react-native-safe-area-context": "5.6.2",
        "react-native-screens": "4.23.0",
        "react-native-svg": "15.15.3",
        "uuid": "catalog:"
    },
    "devDependencies": {
        "@babel/core": "7.29.0",
        "@types/react": "19.2.14",
        "@vex-chat/eslint-config": "workspace:*",
        "@vex-chat/libvex": "catalog:",
        "babel-preset-expo": "55.0.15",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">= 22.11.0"
    },
    "license": "AGPL-3.0-or-later"
}
