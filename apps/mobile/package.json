{
    "name": "@vex-chat/mobile",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "android:clean-autolinking": "node -e \"require('node:fs').rmSync('android/build/generated/autolinking', { recursive: true, force: true })\"",
        "android": "pnpm run android:clean-autolinking && bash ./scripts/run-with-android-jdk.sh bash ./scripts/android-run.sh",
        "android:dev": "bash ./scripts/android-dev.sh",
        "android:dev:local": "EXPO_PUBLIC_ENABLE_DEV_SERVER=1 EXPO_PUBLIC_SERVER_URL=localhost:16777 EXPO_PUBLIC_DEV_API_KEY=local-dev VEX_ANDROID_REVERSE_SPIRE=1 bash ./scripts/android-dev.sh",
        "android:dev:install": "bash ./scripts/android-dev-install.sh",
        "android:prod": "bash ./scripts/android-prod.sh",
        "android:prod:install": "bash ./scripts/android-prod-install.sh",
        "android:staging": "pnpm run android:dev",
        "android:multi": "bash ./scripts/run-with-android-jdk.sh bash ./scripts/android-with-logs.sh",
        "android:emulator": "bash ./scripts/run-with-android-jdk.sh bash ./scripts/start-android-emulator.sh",
        "android:release:install-all": "bash ./scripts/release-apk-install-all.sh",
        "android:reset-db": "bash ./scripts/android-reset-db.sh",
        "ios:dev:install": "bash ./scripts/ios-dev-install.sh",
        "ios:prod:install": "bash ./scripts/ios-prod-install.sh",
        "ios:release:install": "pnpm run ios:prod:install",
        "ios": "expo run:ios",
        "ios:dev:local": "EXPO_PUBLIC_ENABLE_DEV_SERVER=1 EXPO_PUBLIC_SERVER_URL=localhost:16777 EXPO_PUBLIC_DEV_API_KEY=local-dev expo run:ios",
        "dev": "pnpm run android:multi",
        "icons:regen": "bash ./scripts/generate-icons-from-vex-svg.sh",
        "dev:metro": "expo start --dev-client",
        "dev:local": "bash ./scripts/dev-local.sh",
        "dev:local:ios": "bash ./scripts/dev-local.sh --ios --host localhost",
        "dev:lan": "EXPO_PUBLIC_SERVER_URL=$(ipconfig getifaddr en0):16777 bash ./scripts/dev-local.sh",
        "dev:android-reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:16777 tcp:16777 && bash ./scripts/dev-local.sh",
        "prebuild": "expo prebuild --clean",
        "start": "expo start",
        "logs:android:all": "bash ./scripts/logcat-all-devices.sh",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "license:check": "npx @onebeyond/license-checker scan --allowOnly MIT ISC BSD-2-Clause BSD-3-Clause Apache-2.0 0BSD MPL-2.0 CC0-1.0 CC-BY-4.0 Unlicense BlueOak-1.0.0 Python-2.0 Zlib PSF-2.0 Artistic-2.0 AGPL-3.0-or-later WTFPL --ignoreRootPackageLicense --disableReport"
    },
    "dependencies": {
        "@expo/vector-icons": "catalog:",
        "@nanostores/react": "catalog:",
        "@notifee/react-native": "catalog:",
        "@react-navigation/bottom-tabs": "^7.18.14",
        "@react-navigation/native": "^7.3.14",
        "@react-navigation/native-stack": "^7.18.6",
        "@vex-chat/store": "workspace:*",
        "expo": "^57.0.8",
        "expo-application": "catalog:",
        "expo-audio": "catalog:",
        "expo-background-fetch": "catalog:",
        "expo-background-task": "catalog:",
        "expo-blur": "~57.0.2",
        "expo-camera": "catalog:",
        "expo-constants": "catalog:",
        "expo-crypto": "catalog:",
        "expo-document-picker": "catalog:",
        "expo-file-system": "catalog:",
        "expo-font": "catalog:",
        "expo-haptics": "~57.0.1",
        "expo-image-manipulator": "catalog:",
        "expo-image-picker": "^57.0.6",
        "expo-intent-launcher": "catalog:",
        "expo-notifications": "~57.0.7",
        "expo-secure-store": "^57.0.1",
        "expo-sharing": "catalog:",
        "expo-sqlite": "^57.0.1",
        "expo-task-manager": "catalog:",
        "expo-updates": "~57.0.10",
        "expo-video": "catalog:",
        "highlight.js": "catalog:",
        "kysely": "catalog:",
        "kysely-expo": "^56.0.0",
        "nanostores": "catalog:",
        "react": "catalog:",
        "react-native": "0.83.4",
        "react-native-get-random-values": "^2.0.0",
        "react-native-iap": "catalog:",
        "react-native-logs": "^5.6.0",
        "react-native-nitro-modules": "catalog:",
        "react-native-passkey": "catalog:",
        "react-native-safe-area-context": "5.8.0",
        "react-native-screens": "4.26.2",
        "react-native-svg": "^15.15.5",
        "react-native-webrtc": "^124.0.8",
        "uuid": "catalog:"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@types/react": "^19.2.17",
        "@vex-chat/eslint-config": "workspace:*",
        "@vex-chat/libvex": "catalog:",
        "babel-preset-expo": "^55.0.15",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">= 22.11.0"
    },
    "license": "AGPL-3.0-or-later"
}
