# apps/mobile environment variables (example - copy to .env.local to use)
#
# .env.local is gitignored. .env.example is the only committed env file and
# exists purely to document available overrides. Production builds default
# to api.vex.wtf with NO .env involvement - the prod URL is a typed constant
# in src/lib/config.ts and cannot be changed via environment.
#
# The default pnpm mobile dev scripts set VEX_MOBILE_TARGET=dev, so the
# generated Vex Developer build selects chat.vex.mobile.dev and dev.vex.wtf
# without a copied env file. Use VEX_MOBILE_TARGET only when running Expo CLI
# directly instead of the package scripts.
# VEX_MOBILE_TARGET=dev
#
# For a local or per-machine API/spire override, set both:
# EXPO_PUBLIC_ENABLE_DEV_SERVER=1
# EXPO_PUBLIC_SERVER_URL=localhost:16777
#
# EXPO_PUBLIC_SERVER_URL changes only the app's API/WebSocket server. It does
# not change the native passkey relying-party host because iOS and Android
# require that host to publish app association files over HTTPS.
#
# Common EXPO_PUBLIC_SERVER_URL values:
#   - iOS simulator:   EXPO_PUBLIC_SERVER_URL=localhost:16777
#   - Android emu:     EXPO_PUBLIC_SERVER_URL=localhost:16777  (with `adb reverse tcp:16777 tcp:16777`)
#   - LAN device:      EXPO_PUBLIC_SERVER_URL=192.168.x.x:16777
#   - Tailscale/off-LAN: EXPO_PUBLIC_SERVER_URL=100.x.y.z:16777
#
# Optional iOS bundle identifier override used by Expo prebuild.
# Useful for self-signing with a Personal Team (must be globally unique).
# Native iOS passkeys also require dev.vex.wtf's AASA file to list the final
# signed app identifier as <APPLE_TEAM_ID>.<bundle id>.
VEX_IOS_BUNDLE_IDENTIFIER=
#
# Optional escape hatch for local iOS builds signed with a profile that cannot
# carry Associated Domains or push entitlements. Passkeys will not work in this
# mode because the native entitlement is intentionally stripped. To test iOS
# passkeys, use a signing team/profile that can carry Associated Domains and
# make sure dev.vex.wtf lists <APPLE_TEAM_ID>.chat.vex.mobile.dev in AASA.
VEX_DISABLE_IOS_CAPABILITIES=
#
# Optional Android Firebase config used by Expo prebuild for FCM push tokens.
# For staging, download google-services.json from Firebase for package
# chat.vex.mobile.dev and save it as apps/mobile/google-services.staging.json.
VEX_ANDROID_GOOGLE_SERVICES_FILE=
#
# Optional passkey relying-party host used for native app association:
# - production defaults to api.vex.wtf
# - development defaults to dev.vex.wtf
# Set this when pointing a native build at another HTTPS host you control.
# Do not point this at localhost for native passkeys; localhost is only useful
# for browser WebAuthn development.
VEX_PASSKEY_RP_HOST=
#
# Release builds throw at startup if this resolves to a dev host.
EXPO_PUBLIC_ENABLE_DEV_SERVER=
EXPO_PUBLIC_SERVER_URL=
