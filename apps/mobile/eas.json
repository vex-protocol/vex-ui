{
    "cli": {
        "version": ">= 12.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "dev": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "VEX_MOBILE_TARGET": "dev"
            },
            "android": { "buildType": "apk" }
        },
        "development": {
            "channel": "development",
            "distribution": "internal",
            "env": {
                "VEX_MOBILE_TARGET": "development"
            },
            "android": { "buildType": "apk" },
            "autoIncrement": true
        },
        "production": {
            "channel": "production",
            "distribution": "internal",
            "env": {
                "VEX_MOBILE_TARGET": "production"
            },
            "android": { "buildType": "apk" },
            "autoIncrement": true
        }
    }
}
