{
    "name": "@vex-chat/desktop",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "node ./scripts/desktop-flavor.mjs dev development",
        "build": "pnpm run build:production",
        "build:development": "node ./scripts/desktop-flavor.mjs build development",
        "build:production": "node ./scripts/desktop-flavor.mjs build production",
        "install:development": "node ./scripts/desktop-flavor.mjs install development",
        "install:production": "node ./scripts/desktop-flavor.mjs install production",
        "icons:regen": "bash ../../scripts/generate-app-icons.sh",
        "vite:dev": "vite --host localhost",
        "vite:local": "VITE_PROXY_TARGET=http://localhost:16777 vite --host localhost",
        "vite:build": "vite build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "license:check": "npx @onebeyond/license-checker scan --allowOnly MIT ISC BSD-2-Clause BSD-3-Clause Apache-2.0 0BSD MPL-2.0 CC0-1.0 CC-BY-4.0 Unlicense BlueOak-1.0.0 Python-2.0 Zlib PSF-2.0 Artistic-2.0 AGPL-3.0-or-later WTFPL --ignoreRootPackageLicense --disableReport"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tauri-apps/cli": "catalog:",
        "@tsconfig/svelte": "^5.0.6",
        "@types/node": "catalog:",
        "@vex-chat/eslint-config": "workspace:*",
        "@vex-chat/libvex": "catalog:",
        "eslint-plugin-svelte": "^3.17.0",
        "prettier-plugin-svelte": "^3.5.1",
        "svelte": "catalog:",
        "svelte-check": "^4.3.4",
        "svelte-eslint-parser": "^1.6.0",
        "typescript": "catalog:",
        "vite": "^7.3.5"
    },
    "dependencies": {
        "@lucide/svelte": "catalog:",
        "@tauri-apps/api": "catalog:",
        "@tauri-apps/plugin-deep-link": "^2.4.9",
        "@tauri-apps/plugin-http": "catalog:",
        "@tauri-apps/plugin-log": "^2.9.0",
        "@tauri-apps/plugin-notification": "^2",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-sql": "^2.4.0",
        "@tauri-apps/plugin-updater": "^2.10.0",
        "@vex-chat/store": "workspace:*",
        "dompurify": "catalog:",
        "eventemitter3": "5.0.4",
        "highlight.js": "catalog:",
        "kysely": "catalog:",
        "kysely-dialect-tauri": "^2.0.1",
        "marked": "catalog:",
        "nanostores": "catalog:",
        "svelte-spa-router": "^5.1.1",
        "uuid": "catalog:"
    },
    "license": "AGPL-3.0-or-later"
}
