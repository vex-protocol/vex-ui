# apps/desktop environment variables
#
# Default:
# - pnpm -F desktop dev starts Tauri.
# - Tauri starts Vite on http://localhost:5180.
# - Vite proxies API and websocket traffic to https://dev.vex.wtf.
#
# Point the default desktop dev command at local Spire:
# VITE_PROXY_TARGET=http://localhost:16777
#
# Point explicitly at development Spire:
# VITE_PROXY_TARGET=https://dev.vex.wtf
#
# Usually leave this empty. The desktop client should talk to Vite so proxying
# and websocket upgrades work consistently.
# VITE_SERVER_URL=localhost:5180
